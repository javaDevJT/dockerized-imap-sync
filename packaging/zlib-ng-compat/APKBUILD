# zlib-ng's supported zlib ABI replaces the affected upstream zlib library.
pkgname=zlib-ng-compat
pkgver=2.3.3
pkgrel=2
pkgdesc="zlib-ng built with the zlib-compatible ABI"
url="https://github.com/zlib-ng/zlib-ng"
arch="all"
license="Zlib"
provides="zlib"
replaces="zlib"
source="zlib-ng-$pkgver.tar.gz::https://github.com/zlib-ng/zlib-ng/archive/refs/tags/$pkgver.tar.gz"
builddir="$srcdir/zlib-ng-$pkgver"

build() {
	./configure --zlib-compat --prefix=/usr --libdir=/usr/lib
	make -j2
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
	# abuild requires a numeric file version; preserve the actual libz.so.1 ABI.
	mv "$pkgdir/usr/lib/libz.so.1.3.1.zlib-ng" "$pkgdir/usr/lib/libz.so.1.3.1"
	ln -sf libz.so.1.3.1 "$pkgdir/usr/lib/libz.so.1"
	ln -sf libz.so.1 "$pkgdir/usr/lib/libz.so"
	readelf -d "$pkgdir/usr/lib/libz.so.1.3.1" | grep -q 'Library soname: \[libz\.so\.1\]'
	rm -rf "$pkgdir/usr/include" "$pkgdir/usr/lib/pkgconfig" "$pkgdir/usr/share"
	rm -f "$pkgdir/usr/lib/libz.a"
}

sha512sums="
e2057c764f1d5aaee738edee7e977182c5b097e3c95489dcd8de813f237d92a05daaa86d68d44b331d9fec5d1802586a8f6cfb658ba849874aaa14e72a8107f5  zlib-ng-2.3.3.tar.gz
"
